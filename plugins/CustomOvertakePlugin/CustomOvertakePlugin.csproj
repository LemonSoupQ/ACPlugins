<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CustomOvertakePlugin</RootNamespace>
  </PropertyGroup>

  <!-- DLLs found in the server's root folder. Adjust HintPaths if your layout differs. -->
  <ItemGroup>
    <Reference Include="AssettoServer">
      <HintPath>..\..\AssettoServer.dll</HintPath>
    </Reference>
    <Reference Include="AssettoServer.Shared">
      <HintPath>..\..\AssettoServer.Shared.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
